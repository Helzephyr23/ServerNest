# Biryani Configuration

# Panel
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
API_PORT=3001

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# Database
DATABASE_PATH=./data/biryani.db

# Docker
DOCKER_IMAGE=itzg/minecraft-server
SERVER_PORT_RANGE_START=25565
SERVER_PORT_RANGE_END=25665

# Node (agent)
NODE_NAME=master
NODE_API_KEY=change-me-to-a-random-string
GRPC_PORT=50051

# AI (optional)
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
