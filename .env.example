# ServerNest - Minecraft Server Panel Configuration

# Panel web interface port
PANEL_PORT=3000

# API server port
API_PORT=3001

# JWT secret for authentication (CHANGE THIS!)
JWT_SECRET=change-me-in-production

# Supplementary GID the API container needs to read /var/run/docker.sock.
# The container runs as non-root, but the socket is usually root:root 660.
# Check your host with: stat -c '%g' /var/run/docker.sock
# 0 works out of the box on stock Docker and Docker Desktop.
DOCKER_GID=0

# Root directory for Minecraft world data (holds server-1/, server-2/, ...).
#
# This value is used TWICE in docker-compose.yml: once as the bind source and
# once as the bind target, so the path is identical inside and outside the API
# container. That is required, not stylistic. The panel hands
# ${SERVER_DATA_DIR}/server-<id> to Docker as the bind source for every
# Minecraft container, so the daemon resolves it on the host. If the panel read
# a different directory than the daemon writes, mod installs, file
# upload/download, server import and clone would all silently operate on an
# empty folder while the Minecraft server itself worked fine.
#
# Must be an ABSOLUTE path.
#   Linux:            SERVER_DATA_DIR=/srv/servernest/data
#   Docker Desktop:   SERVER_DATA_DIR=/srv/servernest/data
#
# On Docker Desktop the "host" is the Linux VM, so this path lives in the VM's
# disk rather than in your Windows folders. That is fine (it persists), but to
# keep worlds in a Windows directory use the VM mount path instead, e.g.
#   SERVER_DATA_DIR=/run/desktop/mnt/host/c/srv/servernest/data
SERVER_DATA_DIR=/srv/servernest/data

# Database file location
DATABASE_PATH=./data/servernest.db

# Docker image for Minecraft servers
DOCKER_IMAGE=itzg/minecraft-server

# Port range for Minecraft servers
SERVER_PORT_RANGE_START=25565
SERVER_PORT_RANGE_END=25665

# Multi-node (agent) configuration
NODE_NAME=master
NODE_API_KEY=change-me-to-a-random-string
GRPC_PORT=50051

# Panel host binding (0.0.0.0 for Docker, 127.0.0.1 for local dev)
PANEL_HOST=0.0.0.0

# CORS origin (set to your frontend URL in production, e.g. https://panel.example.com)
# Default: disallows all cross-origin requests in production
CORS_ORIGIN=

# Socket.IO origin override (rarely needed).
# REST and Socket.IO are always same-origin: Next.js proxies /api/* and
# /socket.io/* to the API, so this works from any host. Leave unset unless
# the API runs on a genuinely different public origin than the panel.
NEXT_PUBLIC_SOCKET_URL=

# Dev-mode origins allowed to load /_next/* assets (comma-separated).
# Next.js dev blocks cross-origin requests to avoid DNS rebinding; Wildcards
# are supported. The default `**.ts.net` covers Tailscale funnel hostnames
# (e.g. https://machine.tailXXXX.ts.net). Leave unset for localhost-only.
ALLOWED_DEV_ORIGINS=**.ts.net

# Google Drive OAuth (for cloud backup storage)
# Create a Web Application OAuth client at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3000/api/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
