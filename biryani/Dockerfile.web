FROM node:20-alpine AS base

WORKDIR /app

COPY package.json pnpm-workspace.yaml ./
COPY web/package.json ./web/

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
RUN pnpm install --frozen-lockfile

COPY web/ ./web/
COPY src/ ./src/

WORKDIR /app/web
RUN pnpm build

EXPOSE 3000

CMD ["pnpm", "start"]
