{
  "name": "@biryani/api",
  "version": "0.1.0",
  "description": "Biryani API server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/lib-storage": "3.1090.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/jwt": "10.2.0",
    "@fastify/multipart": "9.4.0",
    "argon2": "0.41.1",
    "better-sqlite3": "11.10.0",
    "dockerode": "4.0.12",
    "dotenv": "16.6.1",
    "dropbox": "10.37.1",
    "fastify": "5.12.1",
    "googleapis": "173.0.0",
    "otplib": "13.4.1",
    "qrcode": "1.5.4",
    "socket.io": "4.8.3",
    "tar-fs": "3.1.3",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/dockerode": "3.3.47",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
