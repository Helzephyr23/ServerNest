{
  "name": "biryani",
  "version": "0.1.0",
  "description": "Free, self-hosted Minecraft server management panel",
  "license": "GPL-3.0-only",
  "private": true,
  "workspaces": [
    "src",
    "web",
    "agent"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=src\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=src && npm run build --workspace=web",
    "start": "npm run start --workspace=src",
    "lint": "npm run lint --workspace=src && npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "concurrently": "9.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cron-parser": "^5.10.0"
  },
  "overrides": {
    "sharp": ">=0.35.0",
    "postcss": ">=8.5.23"
  }
}
