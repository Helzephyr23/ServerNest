{
  "name": "biryani",
  "version": "0.1.0",
  "description": "Free, self-hosted Minecraft server management panel",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @biryani/api dev\" \"pnpm --filter @biryani/web dev\"",
    "build": "pnpm --filter @biryani/api build && pnpm --filter @biryani/web build",
    "start": "pnpm --filter @biryani/api start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @biryani/api db:migrate",
    "test": "pnpm --filter @biryani/api test",
    "test:watch": "pnpm --filter @biryani/api test:watch"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
