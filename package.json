{
  "name": "biryani",
  "version": "0.1.0",
  "description": "Free, self-hosted Minecraft server management panel",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @biryani/api dev\" \"pnpm --filter @biryani/web dev\"",
    "build": "pnpm --filter @biryani/api build && pnpm --filter @biryani/web build",
    "start": "pnpm --filter @biryani/api start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "concurrently": "9.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": ">=1.1.18 <2",
      "brace-expansion@>=2 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=4 <5.0.9": ">=5.0.9 <6",
      "fast-uri@>=3 <3.1.5": ">=3.1.5 <4",
      "fast-uri@>=4 <4.1.2": ">=4.1.2 <5",
      "find-my-way@<=9.6.0": ">=9.7.0 <10",
      "js-yaml@>=4 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "sharp@<0.35.0": ">=0.35.0 <1",
      "uuid@<11.1.1": ">=11.1.1 <12"
    }
  },
  "dependencies": {
    "cron-parser": "^5.10.0"
  }
}
